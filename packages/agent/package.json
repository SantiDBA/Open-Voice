{
  "name": "@open-voice/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "open-voice-agent": "./dist/main.cjs"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.cjs --sourcemap",
    "start": "node dist/main.cjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@open-gpt-live/adapters": "workspace:*",
    "@open-gpt-live/gateway": "workspace:*",
    "@open-gpt-live/protocol": "workspace:*",
    "dotenv": "^16.4.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}