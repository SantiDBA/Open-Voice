FROM node:22-alpine AS build

RUN corepack enable
WORKDIR /app

# `packages/agent` builds against `@open-gpt-live/gateway`, `@open-gpt-live/adapters`
# and `@open-gpt-live/protocol`, and esbuild bundles all three into `dist/main.cjs`.
# Every workspace manifest therefore has to exist before `pnpm install` so the
# frozen lockfile resolves the same importers it was generated for.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/gateway/package.json apps/gateway/package.json
COPY packages/agent/package.json packages/agent/package.json
COPY packages/adapters/package.json packages/adapters/package.json
COPY packages/protocol/package.json packages/protocol/package.json
RUN pnpm install --frozen-lockfile

COPY apps/gateway apps/gateway
COPY packages/agent packages/agent
COPY packages/adapters packages/adapters
COPY packages/protocol packages/protocol
RUN pnpm --filter @open-voice/agent build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    GATEWAY_HOST=0.0.0.0 \
    GATEWAY_PORT=8787

# `esbuild --bundle` inlines the gateway, the adapters, the protocol package,
# dotenv and `ws`, so the single bundled entry point is the whole runtime.
COPY --from=build /app/packages/agent/dist ./dist

USER node
EXPOSE 8787
CMD ["node", "dist/main.cjs"]