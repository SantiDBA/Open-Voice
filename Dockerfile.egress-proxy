FROM node:22-bookworm-slim AS build

RUN corepack enable
WORKDIR /app

# Same shape as Dockerfile.agent and Dockerfile.sandbox: every lockfile
# importer this image needs has to exist before the frozen install.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/egress-proxy/package.json apps/egress-proxy/package.json
COPY apps/gateway/package.json apps/gateway/package.json
COPY apps/sandbox/package.json apps/sandbox/package.json
COPY packages/agent/package.json packages/agent/package.json
COPY packages/adapters/package.json packages/adapters/package.json
COPY packages/protocol/package.json packages/protocol/package.json
RUN pnpm install --frozen-lockfile

COPY apps/egress-proxy apps/egress-proxy
RUN pnpm --filter @open-voice/egress-proxy build

# The proxy needs nothing but Node: it makes decisions over sockets it forwards.
# No shell beyond the base image, no tooling.
FROM node:22-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production \
    EGRESS_HOST=0.0.0.0 \
    EGRESS_PORT=8080

COPY --from=build /app/apps/egress-proxy/dist ./dist

USER node
EXPOSE 8080
CMD ["node", "dist/main.cjs"]
