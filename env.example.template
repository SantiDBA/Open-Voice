# Open Voice — hybrid runtime configuration.
#
#   cp env.example.template .env
#   sed -i "s|^LLM_API_KEY=.*|LLM_API_KEY=$OMNIROUTE_API_KEY|" .env
#
# This file is tracked and holds placeholders only. `.env` is git-ignored and is
# the only place a credential belongs. Never put a real token here, and never put
# a token in a NEXT_PUBLIC_* variable: those are compiled into the browser bundle
# and shipped to every client.
#
# One URL matters, and it is loopback. The agent runs with `network_mode: host`,
# so it sees the host's network stack directly.

# ── LLM: OmniRoute on this machine ───────────────────────────────────────────
# The agent shares the host network namespace (`network_mode: host`), so loopback
# is both correct and the fastest route. On rootless Docker there is no usable
# container route to a host service: `host.docker.internal` refuses connections,
# the slirp gateway is unreachable, and going out through the host's WiFi address
# measured anywhere between 1.4 s and 18 s for the same request.
LLM_BASE_URL=http://127.0.0.1:20128/v1

# Bearer token for OmniRoute. Substitute it from your shell environment:
#   LLM_API_KEY=replace-with-your-omniroute-token
LLM_API_KEY=

# Any OmniRoute combo that resolves to a chat model. `auto/best` is not valid.
# Measured time to first token: auto/chat 544 ms, auto/best-chat 1300 ms. Voice turns
# are dominated by that latency, so the chat combo is the default here. See
# docs/runbook.md, section 10.
LLM_MODEL=auto/chat

# ── Speech to text: Speaches (faster-whisper), published on loopback ──────────
# No credential: the agent omits Authorization for explicit non-OpenAI URLs.
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-base
# Measured on this CPU with 2.4 s of real speech: tiny 1.6 s, base 2.9 s,
# small 9.4 s, with identical transcripts on the reference clip. base is the
# default; tiny is faster but weaker on accents and room noise.

# Realtime STT is the OpenAI Realtime WebSocket protocol. Speaches does not speak
# it and the upstream adapter cannot be redirected off api.openai.com, so it
# stays off. Live Mode still emits partial transcripts by re-transcribing the
# accumulated audio during the turn; it just is not token-delta streaming.
STT_REALTIME_ENABLED=false

# ── Text to speech: Speaches (Kokoro), published on loopback ─────────────────
TTS_ENABLED=true
TTS_BASE_URL=http://127.0.0.1:8000/v1
TTS_API_KEY=
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX

# Required. The vendored adapter falls back to the OpenAI voice `alloy` when
# this is unset, and Kokoro has no such voice. Verify the exact id against
# `curl http://127.0.0.1:8000/v1/models` before trusting a voice you just found.
TTS_VOICE=ef_dora

# Language routing. Kokoro is ONE multilingual model with one voice per
# language, so this never changes the model, only the voice picked per reply.
# Setting TTS_VOICE_EN turns it on: Spanish goes to TTS_VOICE_ES, English to
# TTS_VOICE_EN, and anything undecidable keeps TTS_VOICE. Leave TTS_VOICE_EN
# unset and the agent uses one fixed voice exactly as before.
# Voices in this image: Spanish ef_dora, em_alex, em_santa.
# English af_*, am_* (American), bf_*, bm_* (British).
TTS_VOICE_ES=ef_dora
TTS_VOICE_EN=af_heart
TTS_FORMAT=mp3

# ── Latency tuning ───────────────────────────────────────────────────────────
# All of these are the gateway's own defaults. An earlier attempt to tune
# TTS_SEGMENT_MIN_LENGTH down to 10 claimed a gain and delivered none: measured
# three runs each, first audible sound was 3.3/5.5/3.6 s at 24 and 4.0/3.9/2.9 s
# at 10, which is noise. Raise the partial interval to make live transcription
# cheaper; lower it to make it appear sooner.
TTS_SEGMENT_MIN_LENGTH=24
TTS_SEGMENT_MAX_LENGTH=240
LIVE_PARTIAL_INITIAL_INTERVAL_MS=2000
LIVE_PARTIAL_LONG_TURN_INTERVAL_MS=5000
LIVE_PARTIAL_LONG_TURN_AFTER_MS=30000

# ── Agent persona ────────────────────────────────────────────────────────────
# Precedence: AGENT_SYSTEM_PROMPT_FILE, then AGENT_SYSTEM_PROMPT, then the
# built-in default in packages/agent/src/prompt.ts. A configured file that is
# unreadable or blank is a startup error, never a silent fall back.
# Write for the ear: short sentences, no markdown, no lists, no emoji.
# AGENT_SYSTEM_PROMPT=You are Open Voice. Answer in at most two spoken sentences.
# AGENT_SYSTEM_PROMPT_FILE=/run/prompts/persona.txt

# ── Transport ────────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787
# Browser-origin allowlist, exact origins, no trailing slash, no path. Empty
# allows every origin, which is fine only while this stays on localhost. This is
# not authentication: the gateway has no user accounts and no access control.
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ── Browser ──────────────────────────────────────────────────────────────────
# This URL is resolved by the browser, not by a container: use ws://localhost
# even though the agent itself is reached through Docker.
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8787
# The agent's tool channel: live tool activity and approval requests. Resolved
# by the browser, so it is localhost even though the agent runs in a container.
NEXT_PUBLIC_TOOLS_WS_URL=ws://localhost:8788

# Browser-side VAD. These are compiled into the bundle at build time, so a change
# here needs `docker compose up -d --build web`. Without echo cancellation,
# headphones are what keep the agent from interrupting itself.
#
# HANGOVER_MS is the silence grace before a live turn closes, and cutting it
# short costs words, not just dead air. Measured by transcribing the same clip
# with its tail removed: nothing cut gives "una frase muy corta", 200 ms gives
# "muy corte", 400 ms gives "muy..." and 600 ms gives "o la presentate in una
# frase". 750 ms is left alone. Do not lower it for speed.
NEXT_PUBLIC_VAD_ADAPTIVE_ENABLED=true
NEXT_PUBLIC_VAD_CALIBRATION_MS=1000
NEXT_PUBLIC_VAD_NOISE_FLOOR_SMOOTHING=0.08
NEXT_PUBLIC_VAD_SPEECH_NOISE_MULTIPLIER=3
NEXT_PUBLIC_VAD_SILENCE_NOISE_MULTIPLIER=1.8
NEXT_PUBLIC_VAD_DYNAMIC_SPEECH_MIN=0.012
NEXT_PUBLIC_VAD_DYNAMIC_SPEECH_MAX=0.12
NEXT_PUBLIC_VAD_DYNAMIC_SILENCE_MIN=0.006
NEXT_PUBLIC_VAD_DYNAMIC_SILENCE_MAX=0.08
NEXT_PUBLIC_VAD_SPEECH_THRESHOLD=0.02
NEXT_PUBLIC_VAD_SILENCE_THRESHOLD=0.012
NEXT_PUBLIC_VAD_START_DEBOUNCE_MS=160
NEXT_PUBLIC_VAD_MIN_SPEECH_MS=200
NEXT_PUBLIC_VAD_HANGOVER_MS=750
NEXT_PUBLIC_VAD_MAX_TURN_MS=30000
NEXT_PUBLIC_VAD_PRE_ROLL_MS=400
NEXT_PUBLIC_VAD_PLAYBACK_THRESHOLD_MULTIPLIER=2.5
NEXT_PUBLIC_VAD_PLAYBACK_SUPPRESS_AFTER_END_MS=300

# ── Agentic actions (tools) ──────────────────────────────────────────────────
# Off by default. With TOOLS_ENABLED unset the agent only speaks; the tool loop
# is opt-in, so nothing about the conversational path changes until you ask for
# it. Turning it on requires the sandbox (below) to be reachable and its token
# to be set, or the agent fails fast at startup rather than acting without a
# credential.
TOOLS_ENABLED=false
# Where the agent reaches the sandbox action API. Through the forwarder that
# publishes it on host loopback, since the sandbox itself has no published port.
SANDBOX_BASE_URL=http://127.0.0.1:8790
# Most model/tool round-trips in one turn, and the ceilings passed to the
# sandbox for a single action. Bounds what one instruction can cost.
TOOLS_MAX_ITERATIONS=12
TOOLS_ACTION_TIMEOUT_MS=120000
TOOLS_MAX_OUTPUT_BYTES=262144

# Where the browser connects to watch tool activity and answer approval
# requests. Loopback only, and reachable without publishing a port because the
# agent shares the host network namespace. The channel refuses every connection
# when ALLOWED_ORIGINS is empty, so the browser origin has to be listed there.
TOOLS_HOST=127.0.0.1
TOOLS_PORT=8788

# What needs your decision before it runs.
#   sandbox — anything confined to the sandbox runs on its own; only actions
#             that leave it ask. This is the default.
#   all     — every tool call waits for approval in the UI. Nothing runs while
#             no browser is connected.
TOOLS_APPROVAL=sandbox

# ── Escalation to the host (optional) ────────────────────────────────────────
# Empty by default, and that is the safe state: with no executor configured the
# agent has no way to reach this machine, and is not even told the option exists.
#
# Two ways to start the executor:
#
# A) In the compose stack: it runs as the `host-executor` service on
#    127.0.0.1:8791 with dry-run ON, and the agent points at it automatically.
#
# B) By hand:
#    HOST_EXECUTOR_TOKEN=<a-long-random-value> \
#    HOST_EXECUTOR_ALLOWED_COMMANDS="git status,npm test" \
#    pnpm --filter @open-voice/host-executor start
#
# Every host action is gated: it appears in the UI and only runs if you approve
# it. The executor keeps its own allowlist too, and refuses pipes, chains,
# substitutions and redirects outright, because an allowlist over a compound
# command is not an allowlist.
#
# In dry-run (the default), commands run in the host-executor container, not on
# your machine. Set HOST_EXECUTOR_DRY_RUN=false and HOST_EXECUTOR_HOST to an
# SSH address to escalate to the real host — but you must also set
# HOST_EXECUTOR_TOKEN (the same one the agent uses) and configure SSH keys.
HOST_EXECUTOR_BASE_URL=
HOST_EXECUTOR_TOKEN=
HOST_EXECUTOR_PORT=8791
# Dry-run keeps host actions inside the container namespace until you are ready
# to grant real SSH access. Defaults to true; set to false only when the host
# executor is configured to reach a real machine.
HOST_EXECUTOR_DRY_RUN=true
# The working directory all host actions are confined to (path escape is refused).
HOST_EXECUTOR_ROOT=/workspace
# The allowlist is empty by default: no commands may run until you add them.
# Patterns use glob matching, e.g. "echo *,git status,ls -la *".
HOST_EXECUTOR_ALLOWED_COMMANDS=
# Domains the browse/search tools may fetch. Empty means no browsing or
# searching at all (deny-by-default). The search tool uses DuckDuckGo's HTML
# endpoint, so add html.duckduckgo.com to use it:
#   HOST_EXECUTOR_EGRESS_ALLOWLIST=*.duckduckgo.com,example.com
HOST_EXECUTOR_EGRESS_ALLOWLIST=
# Hard cap for one host action and its output.
HOST_EXECUTOR_TIMEOUT_MS=120000
HOST_EXECUTOR_MAX_OUTPUT_BYTES=262144

# ── Sandbox (agentic actions) ────────────────────────────────────────────────
# The sandbox is the container the agent's commands run inside. It is the only
# place agent-authored code executes, and it can touch exactly one directory.
#
# Default is a Docker named volume, which works out of the box: Docker seeds it
# from the image so it belongs to the container's unprivileged user. Point this
# at a host directory to browse the agent's work directly — note that under
# rootless Docker the container's uid 1000 is not your uid, so the directory
# must be writable by the mapped user (see docs/architecture.md).
# Never point it at this repository or at your home directory.
SANDBOX_WORKSPACE_DIR=sandbox-workspace

# Bearer token for the action API, published on 127.0.0.1:8790, and the same
# value the agent presents when it calls it. Required: the sandbox refuses to
# start without it, because an action API with no credential is an
# unauthenticated command executor, and the agent refuses to enable tools
# without it. Generate one with:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
SANDBOX_TOKEN=

# One action's wall-clock ceiling, and how many output bytes are kept per stream
# before the rest is dropped. These bound a runaway command's time and memory.
SANDBOX_ACTION_TIMEOUT_MS=120000
SANDBOX_MAX_OUTPUT_BYTES=262144

# Resource ceilings for the sandbox container: it cannot use more memory, CPU or
# processes than this, whatever a command tries.
SANDBOX_MEMORY_LIMIT=1g
SANDBOX_CPUS=2
SANDBOX_PIDS_LIMIT=256
SANDBOX_GATEWAY_MEMORY_LIMIT=128m
SANDBOX_GATEWAY_CPUS=0.25

# ── Egress allowlist ─────────────────────────────────────────────────────────
# What the sandbox may reach. Empty means no egress at all, which is the
# default: the sandbox sits on an internal Docker network with no route out and
# can only leave through the proxy, which checks this list and refuses any name
# that resolves to a loopback, private or metadata address.
#
# Patterns: `registry.npmjs.org` matches that name exactly; `*.github.com`
# matches subdomains but not the apex, so list both when you need both.
SANDBOX_ALLOWED_DOMAINS=
EGRESS_MEMORY_LIMIT=256m
EGRESS_CPUS=0.5