FROM node:22-bookworm-slim AS build

RUN corepack enable
WORKDIR /app

# The frozen lockfile resolves every workspace importer, so each manifest it
# references has to exist before `pnpm install` — the same shape as
# Dockerfile.host-executor.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/browserbot/package.json apps/browserbot/package.json
COPY apps/egress-proxy/package.json apps/egress-proxy/package.json
RUN pnpm install --frozen-lockfile

COPY apps/browserbot apps/browserbot
COPY apps/egress-proxy apps/egress-proxy
RUN pnpm --filter @open-voice/browserbot build

# The browserbot runtime: Playwright + headless Chromium. Chromium cannot run
# without --no-sandbox as a non-root user inside a container, but the container
# itself is read-only, has no-new-privileges, and is only reachable on the
# internal Docker network (never published to the host).
FROM node:22-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libc6 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libexpat1 \
        libfontconfig1 \
        libgbm1 \
        libgcc1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libstdc++6 \
        libx10-6 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxrandr2 \
        libxrender1 \
        libxss1 \
        libxtst6 \
        lsb-release \
        wget \
        xdg-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV NODE_ENV=production \
    BROWSERBOT_HOST=0.0.0.0 \
    BROWSERBOT_PORT=8793 \
    HOST_EXECUTOR_DRY_RUN=true

COPY --from=build /app/apps/browserbot/dist ./dist
COPY --from=build /app/node_modules/playwright/core/playwright/package.yml ./node_modules/playwright/core/playwright/package.yml

# Install the Chromium browser binary that Playwright needs.
RUN cd /app && node -e "const{resolve}=require('path');const{execFileSync}=require('child_process');try{const p=require('playwright/package.json').version;console.log('Playwright',p)}catch(e){console.error(e);process.exit(1)}" \
    && npx playwright install --with-deps chromium \
    && npx playwright install-deps chromium

RUN mkdir -p /workspace && chown node:node /workspace
USER node

# Playwright needs a writable cache directory for the browser binary.
ENV PLAYWRIGHT_BROWSERS_PATH=/tmp/playwright-browsers
RUN mkdir -p /tmp/playwright-browsers && chown node:node /tmp/playwright-browsers

EXPOSE 8793
CMD ["node", "dist/main.cjs"]
